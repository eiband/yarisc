+//===--- YaRISC.cpp - Implement YaRISC target feature support -------------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// This file implements YaRISC TargetInfo objects.
+//
+//===----------------------------------------------------------------------===//
+
+#include "YaRISC.h"
+#include "Targets.h"
+#include "clang/Basic/MacroBuilder.h"
+#include "llvm/ADT/StringSwitch.h"
+
+using namespace clang;
+using namespace clang::targets;
+
+const char *const YaRISCTargetInfo::GCCRegNames[] = {
+    "r0", "r1", "r2", "r3", "r4", "r5", "sp", "ip",
+};
+
+ArrayRef<const char *> YaRISCTargetInfo::getGCCRegNames() const {
+  return llvm::ArrayRef(GCCRegNames);
+}
+
+ArrayRef<TargetInfo::GCCRegAlias> YaRISCTargetInfo::getGCCRegAliases() const {
+  return llvm::ArrayRef<TargetInfo::GCCRegAlias>();
+}
+
+bool YaRISCTargetInfo::hasFeature(StringRef Feature) const {
+  return llvm::StringSwitch<bool>(Feature)
+      .Case("softfloat", SoftFloat)
+      .Case("yarisc", true)
+      .Default(false);
+}
+
+struct YaRISCCPUInfo {
+  llvm::StringLiteral Name;
+  YaRISCTargetInfo::CPUKind Kind;
+};
+
+static constexpr YaRISCCPUInfo CPUInfo[] = {
+    {{"min"}, YaRISCTargetInfo::CK_MINIMUM},
+    {{"v1"}, YaRISCTargetInfo::CK_V1},
+};
+
+YaRISCTargetInfo::CPUKind YaRISCTargetInfo::getCPUKind(StringRef Name) const {
+  const YaRISCCPUInfo *Item = llvm::find_if(
+      CPUInfo, [Name](const YaRISCCPUInfo &Info) { return Info.Name == Name; });
+
+  if (Item == std::end(CPUInfo))
+    return CK_GENERIC;
+
+  return Item->Kind;
+}
+
+void YaRISCTargetInfo::fillValidCPUList(
+    SmallVectorImpl<StringRef> &Values) const {
+  for (const YaRISCCPUInfo &Info : CPUInfo)
+    Values.push_back(Info.Name);
+}
+
+void YaRISCTargetInfo::getTargetDefines(const LangOptions &Opts,
+                                        MacroBuilder &Builder) const {
+  DefineStd(Builder, "yarisc", Opts);
+  Builder.defineMacro("__yarisc__");
+  Builder.defineMacro("__REGISTER_PREFIX__", "");
+
+  if (SoftFloat)
+    Builder.defineMacro("SOFT_FLOAT", "1");
+}
