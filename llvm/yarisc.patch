+//===-- YaRISCISelDAGToDAG.cpp - A dag to dag inst selector for YaRISC ----===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// This file defines an instruction selector for the YaRISC target.
+//
+//===----------------------------------------------------------------------===//
+
+#include "YaRISCSelectionDAGInfo.h"
+#include "YaRISCTargetMachine.h"
+#include "llvm/CodeGen/MachineRegisterInfo.h"
+#include "llvm/CodeGen/SelectionDAGISel.h"
+#include "llvm/Support/ErrorHandling.h"
+
+using namespace llvm;
+
+#define DEBUG_TYPE "yarisc-isel"
+#define PASS_NAME "YaRISC DAG->DAG Pattern Instruction Selection"
+
+//===----------------------------------------------------------------------===//
+// Instruction Selector Implementation
+//===----------------------------------------------------------------------===//
+
+//===--------------------------------------------------------------------===//
+/// YaRISCDAGToDAGISel - YaRISC specific code to select machine instructions for
+/// SelectionDAG operations.
+///
+namespace {
+class YaRISCDAGToDAGISel final : public SelectionDAGISel {
+public:
+  explicit YaRISCDAGToDAGISel(YaRISCTargetMachine &TM) : SelectionDAGISel(TM) {}
+
+  void Select(SDNode *N) override;
+
+  // Include the pieces autogenerated from the target description.
+#include "YaRISCGenDAGISel.inc"
+};
+
+class YaRISCDAGToDAGISelLegacy final : public SelectionDAGISelLegacy {
+public:
+  static char ID;
+
+  explicit YaRISCDAGToDAGISelLegacy(YaRISCTargetMachine &TM)
+      : SelectionDAGISelLegacy(ID, std::make_unique<YaRISCDAGToDAGISel>(TM)) {}
+};
+} // namespace
+
+char YaRISCDAGToDAGISelLegacy::ID = 0;
+
+INITIALIZE_PASS(YaRISCDAGToDAGISelLegacy, DEBUG_TYPE, PASS_NAME, false, false)
+
+void YaRISCDAGToDAGISel::Select(SDNode *N) {
+  if (N->isMachineOpcode()) {
+    N->setNodeId(-1);
+    return; // Already selected.
+  }
+
+  SelectCode(N);
+}
+
+/// createYaRISCISelDag - This pass converts a legalized DAG into a
+/// YaRISC-specific DAG, ready for instruction scheduling.
+///
+FunctionPass *llvm::createYaRISCISelDag(YaRISCTargetMachine &TM) {
+  return new YaRISCDAGToDAGISelLegacy(TM);
+}
diff --git a/llvm/lib/Target/YaRISC/YaRISCISelLowering.cpp b/llvm/lib/Target/YaRISC/YaRISCISelLowering.cpp
new file mode 100644
index 000000000000..a93d1bd1efa1
--- /dev/null
+++ b/llvm/lib/Target/YaRISC/YaRISCISelLowering.cpp
@@ -0,0 +1,340 @@
+//===-- YaRISCISelLowering.cpp - YaRISC DAG Lowering Implementation -------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// This file implements the interfaces that YaRISC uses to lower LLVM code into
+// a selection DAG.
+//
+//===----------------------------------------------------------------------===//
+
+#include "YaRISCISelLowering.h"
+#include "MCTargetDesc/YaRISCMCTargetDesc.h"
+#include "YaRISCRegisterInfo.h"
+#include "YaRISCSelectionDAGInfo.h"
+#include "YaRISCTargetMachine.h"
+#include "llvm/ADT/StringExtras.h"
+#include "llvm/ADT/StringSwitch.h"
+#include "llvm/BinaryFormat/ELF.h"
+#include "llvm/CodeGen/CallingConvLower.h"
+#include "llvm/CodeGen/MachineFrameInfo.h"
+#include "llvm/CodeGen/MachineFunction.h"
+#include "llvm/CodeGen/MachineInstrBuilder.h"
+#include "llvm/CodeGen/MachineRegisterInfo.h"
+#include "llvm/CodeGen/SelectionDAG.h"
+#include "llvm/CodeGen/SelectionDAGNodes.h"
+#include "llvm/CodeGen/TargetLowering.h"
+#include "llvm/CodeGen/TargetLoweringObjectFileImpl.h"
+#include "llvm/IR/DerivedTypes.h"
+#include "llvm/IR/DiagnosticInfo.h"
+#include "llvm/IR/Function.h"
+#include "llvm/IR/IRBuilder.h"
+#include "llvm/IR/Module.h"
+#include "llvm/Support/ErrorHandling.h"
+#include "llvm/Support/KnownBits.h"
+
+using namespace llvm;
+
+//===----------------------------------------------------------------------===//
+// Calling Convention Implementation
+//===----------------------------------------------------------------------===//
+
+#include "YaRISCGenCallingConv.inc"
+
+// TODO: YaRISC anything special to do for isByVal()?
+
+SDValue YaRISCTargetLowering::LowerFormalArguments(
+    SDValue Chain, CallingConv::ID CallConv, bool IsVarArg,
+    const SmallVectorImpl<ISD::InputArg> &Ins, const SDLoc &DL,
+    SelectionDAG &DAG, SmallVectorImpl<SDValue> &InVals) const {
+  MachineFunction &MF = DAG.getMachineFunction();
+  MachineFrameInfo &MFI = MF.getFrameInfo();
+
+  SmallVector<CCValAssign, 16> ArgLocs;
+  CCState CCInfo(CallConv, IsVarArg, MF, ArgLocs, *DAG.getContext());
+
+  CCInfo.AnalyzeFormalArguments(Ins, CC_YaRISC);
+
+  for (const CCValAssign &VA : ArgLocs) {
+    if (VA.isRegLoc()) {
+      Register VReg = MF.addLiveIn(VA.getLocReg(), &YaRISC::GPRRegClass);
+      SDValue Val = DAG.getCopyFromReg(Chain, DL, VReg, VA.getLocVT());
+
+      switch (VA.getLocInfo()) {
+      default:
+        llvm_unreachable("Unknown loc info!");
+      case CCValAssign::Full:
+        break;
+      case CCValAssign::SExt:
+        Val = DAG.getSExtOrTrunc(Val, DL, VA.getValVT());
+        break;
+      case CCValAssign::ZExt:
+        Val = DAG.getZExtOrTrunc(Val, DL, VA.getValVT());
+        break;
+      case CCValAssign::AExt:
+        Val = DAG.getAnyExtOrTrunc(Val, DL, VA.getValVT());
+        break;
+      case CCValAssign::Trunc:
+        Val = DAG.getNode(ISD::TRUNCATE, DL, VA.getValVT(), Val);
+        break;
+      }
+
+      InVals.push_back(Val);
+    } else {
+      assert(VA.isMemLoc() && "Unknown arg location");
+
+      unsigned Size = VA.getValVT().getStoreSize();
+      int FI = MFI.CreateFixedObject(Size, VA.getLocMemOffset(), true);
+      SDValue FIN = DAG.getFrameIndex(FI, MVT::i16);
+
+      SDValue Load = DAG.getLoad(VA.getValVT(), DL, Chain, FIN,
+                                 MachinePointerInfo::getFixedStack(MF, FI),
+                                 Align(2)); // 2-byte stack alignment for 16-bit
+
+      InVals.push_back(Load);
+    }
+  }
+
+  return Chain;
+}
+
+SDValue
+YaRISCTargetLowering::LowerCall(TargetLowering::CallLoweringInfo &CLI,
+                                SmallVectorImpl<SDValue> &InVals) const {
+  SelectionDAG &DAG = CLI.DAG;
+  SDLoc &DL = CLI.DL;
+  const SmallVectorImpl<ISD::OutputArg> &Outs = CLI.Outs;
+  const SmallVectorImpl<SDValue> &OutVals = CLI.OutVals;
+  const SmallVectorImpl<ISD::InputArg> &Ins = CLI.Ins;
+  SDValue Chain = CLI.Chain;
+  SDValue Callee = CLI.Callee;
+  CallingConv::ID CallConv = CLI.CallConv;
+  bool IsVarArg = CLI.IsVarArg;
+
+  // No tail call optimization so far.
+  CLI.IsTailCall = false;
+
+  MachineFunction &MF = DAG.getMachineFunction();
+
+  SmallVector<CCValAssign, 16> ArgLocs;
+  CCState CCInfo(CallConv, IsVarArg, MF, ArgLocs, *DAG.getContext());
+  CCInfo.AnalyzeCallOperands(Outs, CC_YaRISC);
+
+  unsigned BytesToReserve = CCInfo.getStackSize();
+  Align StackAlign(2); // 2-byte alignment for 16-bit
+
+  Chain = DAG.getCALLSEQ_START(Chain, BytesToReserve, 0, DL);
+
+  SmallVector<std::pair<unsigned, SDValue>, 3> RegsToPass;
+  SmallVector<SDValue, 8> MemOpChains;
+
+  for (unsigned i = 0; i < ArgLocs.size(); ++i) {
+    CCValAssign &VA = ArgLocs[i];
+    SDValue Val = OutVals[i];
+
+    switch (VA.getLocInfo()) {
+    default:
+      llvm_unreachable("Unknown loc info!");
+    case CCValAssign::Full:
+      break;
+    case CCValAssign::SExt:
+      Val = DAG.getSExtOrTrunc(Val, DL, VA.getLocVT());
+      break;
+    case CCValAssign::ZExt:
+      Val = DAG.getZExtOrTrunc(Val, DL, VA.getLocVT());
+      break;
+    case CCValAssign::AExt:
+      Val = DAG.getAnyExtOrTrunc(Val, DL, VA.getLocVT());
+      break;
+    case CCValAssign::Trunc:
+      Val = DAG.getNode(ISD::TRUNCATE, DL, VA.getLocVT(), Val);
+      break;
+    }
+
+    if (VA.isRegLoc()) {
+      RegsToPass.emplace_back(VA.getLocReg(), Val);
+    } else {
+      assert(VA.isMemLoc() && "Unexpected call argument location");
+
+      SDValue SP = DAG.getRegister(YaRISC::SP, MVT::i16);
+      SDValue Off = DAG.getConstant(VA.getLocMemOffset(), DL, MVT::i16);
+      SDValue Ptr = DAG.getNode(ISD::ADD, DL, MVT::i16, SP, Off);
+
+      SDValue Store = DAG.getStore(
+          Chain, DL, Val, Ptr,
+          MachinePointerInfo::getStack(MF, VA.getLocMemOffset()), StackAlign);
+
+      MemOpChains.push_back(Store);
+    }
+  }
+
+  if (!MemOpChains.empty())
+    Chain = DAG.getNode(ISD::TokenFactor, DL, MVT::Other, MemOpChains);
+
+  SDValue Glue;
+  for (auto &RegArg : RegsToPass) {
+    Chain = DAG.getCopyToReg(Chain, DL, RegArg.first, RegArg.second, Glue);
+    Glue = Chain.getValue(1);
+  }
+
+  // For now we don't care about relocation but at some point we might and
+  // therefore the direct and PLT calls are distinguished here. The addresses
+  // are replaced here so that they can be matched with tglobaladdr:$target and
+  // texternalsym:$target when replaced by out call pseudo-instruction.
+  if (auto *S = dyn_cast<GlobalAddressSDNode>(Callee)) {
+    const GlobalValue *GV = S->getGlobal();
+    unsigned OpFlags = getTargetMachine().shouldAssumeDSOLocal(GV)
+                           ? YaRISCII::MO_CALL
+                           : YaRISCII::MO_CALL_PLT;
+    Callee = DAG.getTargetGlobalAddress(
+        GV, DL, getPointerTy(DAG.getDataLayout()), 0, OpFlags);
+  } else if (auto *S = dyn_cast<ExternalSymbolSDNode>(Callee)) {
+    unsigned OpFlags = getTargetMachine().shouldAssumeDSOLocal(nullptr)
+                           ? YaRISCII::MO_CALL
+                           : YaRISCII::MO_CALL_PLT;
+    Callee = DAG.getTargetExternalSymbol(
+        S->getSymbol(), getPointerTy(DAG.getDataLayout()), OpFlags);
+  }
+
+  SmallVector<SDValue, 8> Ops;
+  Ops.push_back(Chain);
+  Ops.push_back(Callee);
+
+  for (auto &Reg : RegsToPass)
+    Ops.push_back(DAG.getRegister(Reg.first, Reg.second.getValueType()));
+
+  const TargetRegisterInfo *TRI = Subtarget->getRegisterInfo();
+  const uint32_t *Mask =
+      TRI->getCallPreservedMask(DAG.getMachineFunction(), CallConv);
+  assert(Mask && "Missing call preserved mask for calling convention");
+  Ops.push_back(DAG.getRegisterMask(Mask));
+
+  if (Glue.getNode()) {
+    Ops.push_back(Glue);
+  }
+
+  SDVTList NodeTys = DAG.getVTList(MVT::Other, MVT::Glue);
+  Chain = DAG.getNode(YaRISCISD::CALL, DL, NodeTys, Ops);
+  Glue = Chain.getValue(1);
+
+  Chain = DAG.getCALLSEQ_END(Chain, BytesToReserve, 0, Glue, DL);
+
+  SmallVector<CCValAssign, 16> RetLocs;
+  CCState RetCCInfo(CallConv, IsVarArg, MF, RetLocs, *DAG.getContext());
+  RetCCInfo.AnalyzeCallResult(Ins, RetCC_YaRISC);
+
+  for (const CCValAssign &VA : RetLocs) {
+    assert(VA.isRegLoc() && "YaRISC returns only in registers");
+    SDValue Val = DAG.getCopyFromReg(Chain, DL, VA.getLocReg(), VA.getLocVT());
+
+    switch (VA.getLocInfo()) {
+    default:
+      llvm_unreachable("Unknown loc info!");
+    case CCValAssign::Full:
+      break;
+    case CCValAssign::SExt:
+      Val = DAG.getSExtOrTrunc(Val, DL, VA.getValVT());
+      break;
+    case CCValAssign::ZExt:
+      Val = DAG.getZExtOrTrunc(Val, DL, VA.getValVT());
+      break;
+    case CCValAssign::AExt:
+      Val = DAG.getAnyExtOrTrunc(Val, DL, VA.getValVT());
+      break;
+    case CCValAssign::Trunc:
+      Val = DAG.getNode(ISD::TRUNCATE, DL, VA.getValVT(), Val);
+      break;
+    }
+
+    InVals.push_back(Val);
+  }
+
+  return Chain;
+}
+
+SDValue
+YaRISCTargetLowering::LowerReturn(SDValue Chain, CallingConv::ID CallConv,
+                                  bool IsVarArg,
+                                  const SmallVectorImpl<ISD::OutputArg> &Outs,
+                                  const SmallVectorImpl<SDValue> &OutVals,
+                                  const SDLoc &DL, SelectionDAG &DAG) const {
+  MachineFunction &MF = DAG.getMachineFunction();
+
+  SmallVector<CCValAssign, 16> RVLocs;
+  CCState CCInfo(CallConv, IsVarArg, MF, RVLocs, *DAG.getContext());
+  CCInfo.AnalyzeReturn(Outs, RetCC_YaRISC);
+
+  SDValue Glue;
+  SmallVector<SDValue, 4> RetOps(1, Chain);
+
+  for (unsigned i = 0; i < RVLocs.size(); ++i) {
+    CCValAssign &VA = RVLocs[i];
+    SDValue Val = OutVals[i];
+
+    switch (VA.getLocInfo()) {
+    default:
+      llvm_unreachable("Unknown loc info!");
+    case CCValAssign::Full:
+      break;
+    case CCValAssign::SExt:
+      Val = DAG.getSExtOrTrunc(Val, DL, VA.getLocVT());
+      break;
+    case CCValAssign::ZExt:
+      Val = DAG.getZExtOrTrunc(Val, DL, VA.getLocVT());
+      break;
+    case CCValAssign::AExt:
+      Val = DAG.getAnyExtOrTrunc(Val, DL, VA.getLocVT());
+      break;
+    }
+
+    Register Reg = VA.getLocReg();
+    Chain = DAG.getCopyToReg(Chain, DL, Reg, Val, Glue);
+    Glue = Chain.getValue(1);
+    RetOps.push_back(DAG.getRegister(Reg, VA.getLocVT()));
+  }
+
+  if (MF.getFunction().hasStructRetAttr()) {
+    // TODO: YaRISC anything special to do here?
+  }
+
+  // Update chain and glue.
+  RetOps[0] = Chain;
+  if (Glue.getNode())
+    RetOps.push_back(Glue);
+
+  return DAG.getNode(YaRISCISD::RET_GLUE, DL, MVT::Other, RetOps);
+}
+
+//===----------------------------------------------------------------------===//
+// TargetLowering Implementation
+//===----------------------------------------------------------------------===//
+
+YaRISCTargetLowering::YaRISCTargetLowering(const TargetMachine &TM,
+                                           const YaRISCSubtarget &STI)
+    : TargetLowering(TM, STI), Subtarget(&STI) {
+  setBooleanContents(ZeroOrOneBooleanContent);
+  setBooleanVectorContents(ZeroOrNegativeOneBooleanContent);
+
+  // Atomics are currently not supported.
+  setMaxAtomicSizeInBitsSupported(0);
+
+  setStackPointerRegisterToSaveRestore(YaRISC::SP);
+  setMinFunctionAlignment(Align(2));
+
+  addRegisterClass(MVT::i16, &YaRISC::GPRRegClass);
+  computeRegisterProperties(STI.getRegisterInfo());
+
+  setOperationAction(ISD::ADD, MVT::i8, Promote);
+  setOperationAction(ISD::ADD, MVT::i32, Expand);
+  setOperationAction(ISD::ADD, MVT::i64, Expand);
+  setOperationAction(ISD::SUB, MVT::i8, Promote);
+  setOperationAction(ISD::SUB, MVT::i32, Expand);
+  setOperationAction(ISD::SUB, MVT::i64, Expand);
+}
+
+bool YaRISCTargetLowering::useSoftFloat() const {
+  return Subtarget->useSoftFloat();
+}
