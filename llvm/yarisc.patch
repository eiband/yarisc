diff --git a/llvm/lib/Target/YaRISC/YaRISC.td b/llvm/lib/Target/YaRISC/YaRISC.td
new file mode 100644
index 000000000000..6c62011633ee
--- /dev/null
+++ b/llvm/lib/Target/YaRISC/YaRISC.td
@@ -0,0 +1,79 @@
+//===-- YaRISC.td - Describe the YaRISC Target Machine -----*- tablegen -*-===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+//
+//===----------------------------------------------------------------------===//
+
+//===----------------------------------------------------------------------===//
+// Target-independent interfaces which we are implementing
+//===----------------------------------------------------------------------===//
+
+include "llvm/Target/Target.td"
+include "llvm/TableGen/SearchableTable.td"
+
+//===----------------------------------------------------------------------===//
+// YaRISC Subtarget features.
+//===----------------------------------------------------------------------===//
+
+def FeatureSoftFloat : SubtargetFeature<"soft-float", "UseSoftFloat", "true",
+                                   "Use software emulation for floating point">;
+
+def FeatureV1 : SubtargetFeature<"v1", "IsV1", "true",
+                                 "Enable YaRISC-V1 instructions">;
+
+//===----------------------------------------------------------------------===//
+// Register File, Calling Conv, Instruction Descriptions
+//===----------------------------------------------------------------------===//
+
+include "YaRISCRegisterInfo.td"
+include "YaRISCCallingConv.td"
+include "YaRISCInstrInfo.td"
+
+defm : RemapAllTargetPseudoPointerOperands<yarisc_ptr_rc>;
+
+def YaRISCInstrInfo : InstrInfo;
+
+def YaRISCAsmParser : AsmParser {
+  let ShouldEmitMatchRegisterAltName = true;
+  let AllowDuplicateRegisterNames = true;
+}
+
+def YaRISCAsmParserVariant : AsmParserVariant {
+  let RegisterPrefix = "%";
+}
+
+//===----------------------------------------------------------------------===//
+// YaRISC processors supported
+//===----------------------------------------------------------------------===//
+
+class Proc<string Name, list<SubtargetFeature> Features,
+           list<SubtargetFeature> TuneFeatures = []>
+ : Processor<Name, NoItineraries, Features, TuneFeatures>;
+
+def : Proc<"generic", [FeatureSoftFloat]>;
+def : Proc<"minimal", [FeatureSoftFloat]>;
+def : Proc<"v1",      [FeatureSoftFloat, FeatureV1]>;
+
+//===----------------------------------------------------------------------===//
+// Declare the target which we are implementing
+//===----------------------------------------------------------------------===//
+
+def YaRISCAsmWriter : AsmWriter {
+  string AsmWriterClassName  = "InstPrinter";
+  int PassSubtarget = 1;
+  int Variant = 0;
+}
+
+def YaRISC : Target {
+  // Pull in Instruction Info:
+  let InstructionSet = YaRISCInstrInfo;
+  let AssemblyParsers  = [YaRISCAsmParser];
+  let AssemblyParserVariants = [YaRISCAsmParserVariant];
+  let AssemblyWriters = [YaRISCAsmWriter];
+  let AllowRegisterRenaming = 1;
+}
