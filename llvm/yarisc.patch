+//===- YaRISCMCAsmInfo.cpp - YaRISC asm properties ------------------------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// This file contains the declarations of the YaRISCMCAsmInfo properties.
+//
+//===----------------------------------------------------------------------===//
+
+#include "YaRISCMCAsmInfo.h"
+#include "llvm/ADT/StringSwitch.h"
+#include "llvm/BinaryFormat/Dwarf.h"
+#include "llvm/BinaryFormat/ELF.h"
+#include "llvm/MC/MCExpr.h"
+#include "llvm/MC/MCStreamer.h"
+#include "llvm/TargetParser/Triple.h"
+
+using namespace llvm;
+
+void YaRISCELFMCAsmInfo::anchor() {}
+
+YaRISCELFMCAsmInfo::YaRISCELFMCAsmInfo(const Triple &TheTriple) {
+  CodePointerSize = CalleeSaveStackSlotSize = 2;
+  MinInstAlignment = 2;
+  MaxInstLength = 4;
+}
+
+void YaRISCELFMCAsmInfo::printSpecifierExpr(raw_ostream &OS,
+                                            const MCSpecifierExpr &Expr) const {
+  StringRef S = YaRISC::getSpecifierName(Expr.getSpecifier());
+  if (!S.empty())
+    OS << '%' << S << '(';
+  printExpr(OS, *Expr.getSubExpr());
+  if (!S.empty())
+    OS << ')';
+}
+
+StringRef YaRISC::getSpecifierName(uint16_t S) {
+  switch (S) {
+  default:
+    llvm_unreachable("Unhandled YaRISC specifier");
+  case 0:
+    return {};
+  case ELF::R_YARISC_8:
+    return "8";
+  case ELF::R_YARISC_16:
+    return "16";
+  case ELF::R_YARISC_DISP8:
+    return "disp8";
+  case ELF::R_YARISC_DISP16:
+    return "disp16";
+  case ELF::R_YARISC_PCREL32:
+    return "pcrel32";
+  }
+}
+
+uint16_t YaRISC::parseSpecifier(StringRef name) {
+  return StringSwitch<uint16_t>(name)
+      .Case("8", ELF::R_YARISC_8)
+      .Case("16", ELF::R_YARISC_16)
+      .Case("disp8", ELF::R_YARISC_DISP8)
+      .Case("disp16", ELF::R_YARISC_DISP16)
+      .Case("pcrel32", ELF::R_YARISC_PCREL32)
+      .Default(0);
+}
