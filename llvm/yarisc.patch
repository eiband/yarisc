+#ifndef LLVM_LIB_TARGET_YARISC_YARISCREGISTERINFO_H
+#define LLVM_LIB_TARGET_YARISC_YARISCREGISTERINFO_H
+
+#include "llvm/CodeGen/TargetRegisterInfo.h"
+
+#define GET_REGINFO_HEADER
+#include "YaRISCGenRegisterInfo.inc"
+
+namespace llvm {
+class YaRISCSubtarget;
+
+struct YaRISCRegisterInfo : public YaRISCGenRegisterInfo {
+public:
+  explicit YaRISCRegisterInfo(const YaRISCSubtarget &STI);
+
+  const MCPhysReg *getCalleeSavedRegs(const MachineFunction *MF) const override;
+  const uint32_t *getCallPreservedMask(const MachineFunction &MF,
+                                       CallingConv::ID CC) const override;
+
