+
+#include "MCTargetDesc/YaRISCMCTargetDesc.h"
+#include "llvm/MC/MCContext.h"
+#include "llvm/MC/MCELFObjectWriter.h"
+#include "llvm/MC/MCExpr.h"
+#include "llvm/MC/MCObjectFileInfo.h"
+#include "llvm/MC/MCObjectWriter.h"
+#include "llvm/MC/MCValue.h"
+#include "llvm/Support/ErrorHandling.h"
+
+using namespace llvm;
+
+namespace {
+class YaRISCELFObjectWriter : public MCELFObjectTargetWriter {
+public:
+  explicit YaRISCELFObjectWriter(uint8_t OSABI)
+      : MCELFObjectTargetWriter(
+            /*Is64Bit*/ false, OSABI, ELF::EM_NONE,
+            /*HasRelocationAddend*/ false) {}
+
+  ~YaRISCELFObjectWriter() override = default;
+
+protected:
+  unsigned getRelocType(const MCFixup &Fixup, const MCValue &Target,
+                        bool IsPCRel) const override;
+};
+} // namespace
+
+unsigned YaRISCELFObjectWriter::getRelocType(const MCFixup &Fixup,
+                                             const MCValue &Target,
+                                             bool IsPCRel) const {
+  auto Kind = Fixup.getKind();
+  if (mc::isRelocation(Kind))
+    return Kind;
+
+  if (const auto *SExpr = dyn_cast<MCSpecifierExpr>(Fixup.getValue())) {
+    switch (SExpr->getSpecifier()) {
+    case ELF::R_YARISC_8:
+    case ELF::R_YARISC_16:
+    case ELF::R_YARISC_DISP8:
+    case ELF::R_YARISC_DISP16:
+      return SExpr->getSpecifier();
+    default:
+      break;
+    }
+  }
+
+  if (IsPCRel) {
+    switch (Kind) {
+    default:
+      llvm_unreachable("Unimplemented fixup -> relocation");
+    case FK_Data_1:
+      return ELF::R_YARISC_DISP8;
+    case FK_Data_2:
+      return ELF::R_YARISC_DISP16;
+    }
+  }
+
+  switch (Kind) {
+  default:
+    llvm_unreachable("Unimplemented fixup -> relocation");
+  case FK_NONE:
+    return ELF::R_YARISC_NONE;
+  case FK_Data_1:
+    return ELF::R_YARISC_8;
+  case FK_Data_2:
+    return ELF::R_YARISC_16;
+  }
+
+  return ELF::R_YARISC_NONE;
+}
+
+std::unique_ptr<MCObjectTargetWriter>
+llvm::createYaRISCELFObjectWriter(uint8_t OSABI) {
+  return std::make_unique<YaRISCELFObjectWriter>(OSABI);
+}
