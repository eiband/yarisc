@@ -0,0 +1,142 @@
+//===-- YaRISCRegisterInfo.cpp - YaRISC Register Information --------------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// This file contains the YaRISC implementation of the TargetRegisterInfo class.
+//
+//===----------------------------------------------------------------------===//
+
+#include "YaRISCRegisterInfo.h"
+#include "YaRISC.h"
+#include "YaRISCSubtarget.h"
+#include "llvm/ADT/BitVector.h"
+#include "llvm/CodeGen/MachineFrameInfo.h"
+#include "llvm/CodeGen/MachineFunction.h"
+#include "llvm/CodeGen/MachineInstrBuilder.h"
+#include "llvm/CodeGen/TargetInstrInfo.h"
+#include "llvm/IR/Type.h"
+#include "llvm/Support/CommandLine.h"
+#include "llvm/Support/ErrorHandling.h"
+#include "llvm/Support/MathExtras.h"
+
+using namespace llvm;
+
+#define GET_REGINFO_TARGET_DESC
+#include "YaRISCGenRegisterInfo.inc"
+
+YaRISCRegisterInfo::YaRISCRegisterInfo(const YaRISCSubtarget &STI)
+    // TODO: YaRISC SP as CFA?
+    : YaRISCGenRegisterInfo(YaRISC::NoRegister, 0, 0, YaRISC::IP) {}
+
+const MCPhysReg *
+YaRISCRegisterInfo::getCalleeSavedRegs(const MachineFunction *MF) const {
+  return CSR_SaveList;
+}
+
+const uint32_t *
+YaRISCRegisterInfo::getCallPreservedMask(const MachineFunction &MF,
+                                         CallingConv::ID CC) const {
+  return CSR_RegMask;
+}
+
+BitVector YaRISCRegisterInfo::getReservedRegs(const MachineFunction &MF) const {
+  const TargetFrameLowering *TFI = MF.getSubtarget().getFrameLowering();
+
+  BitVector Reserved(getNumRegs());
+  Reserved.set(YaRISC::SP); // stack pointer
+  Reserved.set(YaRISC::IP); // program counter
+
+  if (TFI->hasFP(MF))
+    Reserved.set(YaRISC::R5); // frame pointer
+
+  assert(checkAllSuperRegsMarked(Reserved));
+  return Reserved;
+}
+
+const TargetRegisterClass *
+YaRISCRegisterInfo::getPointerRegClass(unsigned Kind) const {
+  assert(Kind == 0 && "this should only be used for default cases");
+  return &YaRISC::GPRRegClass;
+}
+
+bool YaRISCRegisterInfo::eliminateFrameIndex(MachineBasicBlock::iterator II,
+                                             int SPAdj, unsigned FIOperandNum,
+                                             RegScavenger *RS) const {
+  MachineInstr &MI = *II;
+  MachineBasicBlock &MBB = *MI.getParent();
+  MachineFunction &MF = *MBB.getParent();
+  const TargetFrameLowering *TFI = MF.getSubtarget().getFrameLowering();
+  assert(MI.getOpcode() == YaRISC::LDXri16 ||
+         MI.getOpcode() == YaRISC::STXri16 ||
+         MI.getOpcode() == YaRISC::ADDri16);
+
+  int FrameIndex = MI.getOperand(FIOperandNum).getIndex();
+
+  Register FrameReg;
+  StackOffset Offset = TFI->getFrameIndexReference(MF, FrameIndex, FrameReg);
+  int64_t RealOffset =
+      Offset.getFixed() + MI.getOperand(FIOperandNum + 1).getImm();
+
+  bool IsFramePointer = FrameReg == YaRISC::R5;
+  bool IsStackPointer = FrameReg == YaRISC::SP;
+  if (IsStackPointer)
+    RealOffset += SPAdj;
+
+  if (isInt<4>(RealOffset)) {
+    const TargetInstrInfo &TII = *MF.getSubtarget().getInstrInfo();
+    Register Reg = MI.getOperand(0).getReg();
+    DebugLoc DL = MI.getDebugLoc();
+
+    // There are special stack pointer and frame pointer relative loads and
+    // stores for small offsets that fit into one word.
+    if ((IsFramePointer || IsStackPointer) &&
+        (MI.getOpcode() == YaRISC::LDXri16 ||
+         MI.getOpcode() == YaRISC::STXri16)) {
+      unsigned Opcode =
+          MI.getOpcode() == YaRISC::LDXri16
+              ? (IsStackPointer ? YaRISC::LDXspi4 : YaRISC::LDXfpi4)
+              : (IsStackPointer ? YaRISC::STXspi4 : YaRISC::STXfpi4);
+
+      BuildMI(MBB, MI, DL, TII.get(Opcode), Reg).addImm(RealOffset);
+
+      MBB.erase(II);
+      return true;
+    }
+
+    if (MI.getOpcode() == YaRISC::ADDri16) {
+      // Pick a smaller instruction when the source and target are the same or
+      // when the offset is zero. It is unknown whether the registers are ever
+      // the same seems very odd (the frame pointer is probably not being reused
+      // as general purpose register), however for now we just leave it in.
+      if (Reg == FrameReg) {
+        if (RealOffset != 0) {
+          BuildMI(MBB, MI, DL, TII.get(YaRISC::ADDri4), Reg)
+              .addReg(FrameReg)
+              .addImm(RealOffset);
+        }
+
+        MBB.erase(II);
+        return true;
+      } else if (RealOffset == 0) {
+        BuildMI(MBB, MI, DL, TII.get(YaRISC::MOVr), Reg).addReg(FrameReg);
+
+        MBB.erase(II);
+        return true;
+      }
+    }
+  }
+
+  MI.getOperand(FIOperandNum).ChangeToRegister(FrameReg, false);
+  MI.getOperand(FIOperandNum + 1).ChangeToImmediate(RealOffset);
+  // II is not removed.
+  return false;
+}
+
+Register YaRISCRegisterInfo::getFrameRegister(const MachineFunction &MF) const {
+  const TargetFrameLowering *TFI = MF.getSubtarget().getFrameLowering();
+  return TFI->hasFP(MF) ? YaRISC::R5 : YaRISC::SP;
+}
