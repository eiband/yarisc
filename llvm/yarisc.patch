+
+using namespace llvm;
+
+#define GET_INSTRINFO_CTOR_DTOR
+#include "YaRISCGenInstrInfo.inc"
+
+// Pin the vtable to this file.
+void YaRISCInstrInfo::anchor() {}
+
+YaRISCInstrInfo::YaRISCInstrInfo(const YaRISCSubtarget &ST)
+    : YaRISCGenInstrInfo(ST, RI, YaRISC::ADJCALLSTACKDOWN,
+                         YaRISC::ADJCALLSTACKUP),
+      RI(ST), Subtarget(ST) {}
+
+unsigned YaRISCInstrInfo::getInstSizeInBytes(const MachineInstr &MI) const {
+  switch (MI.getOpcode()) {
+  default:
+    return MI.getDesc().getSize();
+  case TargetOpcode::INLINEASM:
+  case TargetOpcode::INLINEASM_BR: {
+    const MachineFunction *MF = MI.getParent()->getParent();
+    const char *AsmStr = MI.getOperand(0).getSymbolName();
+    return getInlineAsmLength(AsmStr, *MF->getTarget().getMCAsmInfo());
+  }
+  }
+}
+
+void YaRISCInstrInfo::copyPhysReg(MachineBasicBlock &MBB,
+                                  MachineBasicBlock::iterator MBBI,
+                                  const DebugLoc &DL, Register DestReg,
+                                  Register SrcReg, bool KillSrc,
+                                  bool RenamableDest, bool RenamableSrc) const {
+  BuildMI(MBB, MBBI, DL, get(YaRISC::MOVr), DestReg)
+      .addReg(SrcReg, getKillRegState(KillSrc));
+}
+
+void YaRISCInstrInfo::storeRegToStackSlot(
+    MachineBasicBlock &MBB, MachineBasicBlock::iterator MBBI, Register SrcReg,
+    bool KillSrc, int FrameIndex, const TargetRegisterClass *RC, Register VReg,
+    MachineInstr::MIFlag Flags) const {
+  MachineFunction &MF = *MBB.getParent();
+  MachineFrameInfo &MFI = MF.getFrameInfo();
+  DebugLoc DL = MBBI != MBB.end() ? MBBI->getDebugLoc() : DebugLoc();
+
+  MachineMemOperand *MMO = MF.getMachineMemOperand(
+      MachinePointerInfo::getFixedStack(MF, FrameIndex),
+      MachineMemOperand::MOStore, MFI.getObjectSize(FrameIndex),
+      MFI.getObjectAlign(FrameIndex));
+
+  BuildMI(MBB, MBBI, DL, get(YaRISC::STXri16))
+      .addReg(SrcReg, getKillRegState(KillSrc))
+      .addFrameIndex(FrameIndex)
+      .addImm(0)
+      .addMemOperand(MMO);
+}
+
+void YaRISCInstrInfo::loadRegFromStackSlot(MachineBasicBlock &MBB,
+                                           MachineBasicBlock::iterator MBBI,
+                                           Register DestReg, int FrameIndex,
+                                           const TargetRegisterClass *RC,
+                                           Register VReg,
+                                           MachineInstr::MIFlag Flags) const {
+  MachineFunction &MF = *MBB.getParent();
+  MachineFrameInfo &MFI = MF.getFrameInfo();
+  DebugLoc DL = MBBI != MBB.end() ? MBBI->getDebugLoc() : DebugLoc();
+
+  MachineMemOperand *MMO = MF.getMachineMemOperand(
+      MachinePointerInfo::getFixedStack(MF, FrameIndex),
+      MachineMemOperand::MOLoad, MFI.getObjectSize(FrameIndex),
+      MFI.getObjectAlign(FrameIndex));
+
+  BuildMI(MBB, MBBI, DL, get(YaRISC::LDXri16), DestReg)
+      .addFrameIndex(FrameIndex)
+      .addImm(0)
+      .addMemOperand(MMO);
+}
+
+bool YaRISCInstrInfo::expandPostRAPseudo(MachineInstr &MI) const {
+  MachineBasicBlock &MBB = *MI.getParent();
+  const DebugLoc &DL = MI.getDebugLoc();
+
+  switch (MI.getOpcode()) {
+  case YaRISC::CALL: {
+    MachineFunction &MF = *MBB.getParent();
+
+    // Make room on the stack for the return address.
+    BuildMI(MBB, MI, DL, get(YaRISC::ADDri4), YaRISC::SP)
+        .addReg(YaRISC::SP)
+        .addImm(-2);
+
+    // The following sequence must stay together because we hard code the offset
+    // until after the jump.
+    MIBundleBuilder Bundle(MBB, MI);
+
+    // The final two instructions occupy six bytes in total. R2 is marked as
+    // implicitly defined. ADDri4 only supports input and output register to be
+    // the same.
+    BuildMI(MBB, MI, DL, get(YaRISC::ADDri16), YaRISC::R2)
+        .addReg(YaRISC::IP)
+        .addImm(6);
+
+    // Alternative to the previous instruction which also requires four bytes
+    // just like the ADDri16 instruction:
+    //
+    // Bundle.append(BuildMI(MF, DL, get(YaRISC::MOVi4), YaRISC::R2).addImm(6));
+    // Bundle.append(BuildMI(MF, DL, get(YaRISC::ADDrr), YaRISC::R2)
+    //                   .addReg(YaRISC::R2)
+    //                   .addReg(YaRISC::IP));
+
+    // Store the calculated return address onto the stack.
+    Bundle.append(BuildMI(MF, DL, get(YaRISC::STRr))
+                      .addReg(YaRISC::R2)
+                      .addReg(YaRISC::SP));
+
+    // Position independent code is not supported.
+    Bundle.append(
+        BuildMI(MF, DL, get(YaRISC::MOVi16), YaRISC::IP).add(MI.getOperand(0)));
+
+    finalizeBundle(MBB, Bundle.begin(), Bundle.end());
+  } break;
+  case YaRISC::RET: {
+    // Update the stack pointer to pop the return address.
+    BuildMI(MBB, MI, DL, get(YaRISC::ADDri4), YaRISC::SP)
+        .addReg(YaRISC::SP)
+        .addImm(2);
+
+    // Load the return address from the stack into the instruction pointer.
+    BuildMI(MBB, MI, DL, get(YaRISC::LDXspi4), YaRISC::IP).addImm(-2);
+  } break;
+  default:
+    return false;
+  }
+
+  MI.eraseFromParent();
+  return true;
+}
+
+bool YaRISCInstrInfo::reverseBranchCondition(
+    SmallVectorImpl<MachineOperand> &Cond) const {
+  // TODO: YaRISC
+  return YaRISCGenInstrInfo::reverseBranchCondition(Cond);
+}
+
+std::pair<unsigned, unsigned>
+YaRISCInstrInfo::decomposeMachineOperandsTargetFlags(unsigned TF) const {
+  const unsigned Mask = YaRISCII::MO_DIRECT_FLAG_MASK;
+  return std::make_pair(TF & Mask, TF & ~Mask);
+}
+
+ArrayRef<std::pair<unsigned, const char *>>
+YaRISCInstrInfo::getSerializableDirectMachineOperandTargetFlags() const {
+  static const std::pair<unsigned, const char *> Flags[] = {
+      {YaRISCII::MO_CALL, "yarisc-call"},
+      {YaRISCII::MO_CALL_PLT, "yarisc-call-plt"},
+  };
+  return Flags;
+}
