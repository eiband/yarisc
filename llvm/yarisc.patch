new file mode 100644
index 000000000000..d282369d5f0f
--- /dev/null
+++ b/llvm/lib/Target/YaRISC/YaRISCFrameLowering.cpp
@@ -0,0 +1,102 @@
+//===-- YaRISCFrameLowering.cpp - YaRISC Frame Information ----------------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// This file contains the YaRISC implementation of TargetFrameLowering class.
+//
+//===----------------------------------------------------------------------===//
+
+#include "YaRISCFrameLowering.h"
+#include "YaRISCInstrInfo.h"
+#include "YaRISCSubtarget.h"
+#include "llvm/CodeGen/CFIInstBuilder.h"
+#include "llvm/CodeGen/MachineFrameInfo.h"
+#include "llvm/CodeGen/MachineFunction.h"
+#include "llvm/CodeGen/MachineInstrBuilder.h"
+#include "llvm/CodeGen/MachineModuleInfo.h"
+#include "llvm/CodeGen/MachineRegisterInfo.h"
+#include "llvm/CodeGen/RegisterScavenging.h"
+#include "llvm/Support/CommandLine.h"
+#include "llvm/Support/MathExtras.h"
+#include "llvm/Target/TargetOptions.h"
+
+using namespace llvm;
+
+YaRISCFrameLowering::YaRISCFrameLowering(const YaRISCSubtarget &ST)
+    : TargetFrameLowering(TargetFrameLowering::StackGrowsDown, Align(2), 0) {}
+
+static void adjustSP(MachineBasicBlock &MBB, MachineBasicBlock::iterator MBBI,
+                     const DebugLoc &DL, const TargetInstrInfo &TII,
+                     int64_t Adjustment) {
+  if (Adjustment != 0) {
+    bool IsSmallImm = isInt<4>(Adjustment);
+    unsigned Opcode = IsSmallImm ? YaRISC::ADDri4 : YaRISC::ADDri16;
+
+    BuildMI(MBB, MBBI, DL, TII.get(Opcode), YaRISC::SP)
+        .addReg(YaRISC::SP)
+        .addImm(Adjustment);
+  }
+}
+
+void YaRISCFrameLowering::emitPrologue(MachineFunction &MF,
+                                       MachineBasicBlock &MBB) const {
+  MachineBasicBlock::iterator MBBI = MBB.begin();
+  DebugLoc DL = (MBBI != MBB.end()) ? MBBI->getDebugLoc() : DebugLoc();
+  const TargetInstrInfo &TII = *MF.getSubtarget().getInstrInfo();
+  uint64_t StackSize = MF.getFrameInfo().getStackSize();
+
+  adjustSP(MBB, MBBI, DL, TII, -static_cast<int64_t>(StackSize));
+
+  if (hasFP(MF)) {
+    // Set new frame pointer.
+    BuildMI(MBB, MBBI, DL, TII.get(YaRISC::MOVr), YaRISC::R5)
+        .addReg(YaRISC::SP);
+  }
+}
+
+void YaRISCFrameLowering::emitEpilogue(MachineFunction &MF,
+                                       MachineBasicBlock &MBB) const {
+  MachineBasicBlock::iterator MBBI = MBB.getFirstTerminator();
+  DebugLoc DL = (MBBI != MBB.end()) ? MBBI->getDebugLoc() : DebugLoc();
+  const TargetInstrInfo &TII = *MF.getSubtarget().getInstrInfo();
+  uint64_t StackSize = MF.getFrameInfo().getStackSize();
+
+  adjustSP(MBB, MBBI, DL, TII, static_cast<int64_t>(StackSize));
+}
+
+MachineBasicBlock::iterator YaRISCFrameLowering::eliminateCallFramePseudoInstr(
+    MachineFunction &MF, MachineBasicBlock &MBB,
+    MachineBasicBlock::iterator I) const {
+  const TargetInstrInfo &TII = *MF.getSubtarget().getInstrInfo();
+  DebugLoc DL = I->getDebugLoc();
+  int64_t Amount = I->getOperand(0).getImm();
+
+  if (Amount != 0 && !hasReservedCallFrame(MF)) {
+    assert(isInt<16>(Amount) && "Offset too large");
+    assert((I->getOpcode() == TII.getCallFrameSetupOpcode() ||
+            I->getOpcode() == TII.getCallFrameDestroyOpcode()) &&
+           "Unknown frame pseudo instruction");
+
+    if (I->getOpcode() == TII.getCallFrameSetupOpcode())
+      Amount = -Amount;
+
+    bool IsSmallImm = isInt<4>(Amount);
+    unsigned Opcode = IsSmallImm ? YaRISC::ADDri4 : YaRISC::ADDri16;
+
+    BuildMI(MBB, I, DL, TII.get(Opcode), YaRISC::SP)
+        .addReg(YaRISC::SP)
+        .addImm(Amount);
+  }
+  return MBB.erase(I);
+}
+
+bool YaRISCFrameLowering::hasFPImpl(const MachineFunction &MF) const {
+  return MF.getTarget().Options.DisableFramePointerElim(MF) ||
+         MF.getFrameInfo().hasVarSizedObjects() ||
+         MF.getFrameInfo().isFrameAddressTaken() ||
+         MF.getSubtarget().getRegisterInfo()->hasStackRealignment(MF);
+}
