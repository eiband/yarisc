@@ -0,0 +1,126 @@
+//===-- YaRISCAsmPrinter.cpp - YaRISC LLVM assembly writer ----------------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// This file contains a printer that converts from the internal representation
+// of machine-dependent LLVM code to assembly language.
+//
+//===----------------------------------------------------------------------===//
+
+#include "MCTargetDesc/YaRISCInstPrinter.h"
+#include "MCTargetDesc/YaRISCMCAsmInfo.h"
+#include "MCTargetDesc/YaRISCMCTargetDesc.h"
+#include "MCTargetDesc/YaRISCTargetStreamer.h"
+#include "TargetInfo/YaRISCTargetInfo.h"
+#include "YaRISC.h"
+#include "YaRISCInstrInfo.h"
+#include "YaRISCTargetMachine.h"
+#include "llvm/BinaryFormat/ELF.h"
+#include "llvm/CodeGen/AsmPrinter.h"
+#include "llvm/CodeGen/MachineInstr.h"
+#include "llvm/CodeGen/MachineModuleInfoImpls.h"
+#include "llvm/CodeGen/MachineRegisterInfo.h"
+#include "llvm/CodeGen/TargetLoweringObjectFileImpl.h"
+#include "llvm/IR/Mangler.h"
+#include "llvm/MC/MCAsmInfo.h"
+#include "llvm/MC/MCContext.h"
+#include "llvm/MC/MCInst.h"
+#include "llvm/MC/MCStreamer.h"
+#include "llvm/MC/MCSymbol.h"
+#include "llvm/MC/TargetRegistry.h"
+#include "llvm/Support/Compiler.h"
+#include "llvm/Support/raw_ostream.h"
+
+using namespace llvm;
+
+#define DEBUG_TYPE "yarisc-asm-printer"
+
+namespace {
+class YaRISCAsmPrinter : public AsmPrinter {
+public:
+  static char ID;
+
+  explicit YaRISCAsmPrinter(TargetMachine &TM,
+                            std::unique_ptr<MCStreamer> Streamer)
+      : AsmPrinter(TM, std::move(Streamer), ID) {}
+
+  StringRef getPassName() const override { return "YaRISC Assembly Printer"; }
+
+  void emitInstruction(const MachineInstr *MI) override;
+
+  void lowerInstruction(const MachineInstr *MI, MCInst &OutMI) const;
+  bool lowerOperand(const MachineOperand &MO, MCOperand &MCOp) const;
+};
+} // namespace
+
+void YaRISCAsmPrinter::emitInstruction(const MachineInstr *MI) {
+  if (MI->isBundle()) {
+    const MachineBasicBlock *MBB = MI->getParent();
+    MachineBasicBlock::const_instr_iterator I = ++MI->getIterator();
+    while (I != MBB->instr_end() && I->isInsideBundle()) {
+      emitInstruction(&*I);
+      ++I;
+    }
+    return;
+  }
+
+  if (MI->isPseudo())
+    return;
+
+  MCInst OutInst;
+  lowerInstruction(MI, OutInst);
+  EmitToStreamer(*OutStreamer, OutInst);
+}
+
+void YaRISCAsmPrinter::lowerInstruction(const MachineInstr *MI,
+                                        MCInst &OutMI) const {
+  OutMI.setOpcode(MI->getOpcode());
+
+  for (const MachineOperand &MO : MI->operands()) {
+    MCOperand MCOp;
+    if (lowerOperand(MO, MCOp))
+      OutMI.addOperand(MCOp);
+  }
+}
+
+bool YaRISCAsmPrinter::lowerOperand(const MachineOperand &MO,
+                                    MCOperand &MCOp) const {
+  switch (MO.getType()) {
+  default:
+    report_fatal_error("lowerOperand: unknown operand type");
+  case MachineOperand::MO_Register:
+    if (MO.isImplicit())
+      return false;
+    MCOp = MCOperand::createReg(MO.getReg());
+    break;
+  case MachineOperand::MO_Immediate:
+    MCOp = MCOperand::createImm(MO.getImm());
+    break;
+  case MachineOperand::MO_GlobalAddress:
+    MCOp = MCOperand::createExpr(MCSpecifierExpr::create(
+        MCSymbolRefExpr::create(getSymbol(MO.getGlobal()), OutContext),
+        ELF::R_YARISC_16, OutContext));
+    break;
+  case MachineOperand::MO_MachineBasicBlock:
+    MCOp = MCOperand::createExpr(MCSpecifierExpr::create(
+        MCSymbolRefExpr::create(MO.getMBB()->getSymbol(), OutContext),
+        ELF::R_YARISC_16, OutContext));
+    break;
+  }
+  return true;
+}
+
+char YaRISCAsmPrinter::ID = 0;
+
+INITIALIZE_PASS(YaRISCAsmPrinter, "yarisc-asm-printer",
+                "YaRISC Assembly Printer", false, false)
+
+// Force static initialization.
+extern "C" LLVM_ABI LLVM_EXTERNAL_VISIBILITY void
+LLVMInitializeYaRISCAsmPrinter() {
+  RegisterAsmPrinter<YaRISCAsmPrinter> X(getTheYaRISCTarget());
+}
diff --git a/llvm/lib/Target/YaRISC/YaRISCCallingConv.td b/llvm/lib/Target/YaRISC/YaRISCCallingConv.td
new file mode 100644
index 000000000000..f382ccb7efcd
--- /dev/null
+++ b/llvm/lib/Target/YaRISC/YaRISCCallingConv.td
@@ -0,0 +1,29 @@
+//===-- YaRISCCallingConv.td - Calling Conventions YaRISC --*- tablegen -*-===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// This describes the calling conventions for the YaRISC architecture.
+//
+//===----------------------------------------------------------------------===//
+
+def CC_YaRISC : CallingConv<[
+  // TODO: YaRISC
+  CCIfType<[i1, i8], CCPromoteToType<i16>>,
+  CCIfType<[i16], CCAssignToReg<[R0, R1]>>,
+  CCIfType<[i32], CCAssignToReg<[R0, R1]>>,
+  // Alternatively, they are assigned to the stack in 2-byte aligned units.
+  CCAssignToStack<2, 2>
+]>;
+
+def RetCC_YaRISC : CallingConv<[
+  // TODO: YaRISC
+  CCIfType<[i1, i8], CCPromoteToType<i16>>,
+  CCIfType<[i16], CCAssignToReg<[R0, R1]>>,
+  CCIfType<[i32], CCAssignToReg<[R0, R1]>>
+]>;
+
+def CSR : CalleeSavedRegs<(add R3, R4, R5)>;
