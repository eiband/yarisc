diff --git a/llvm/lib/Target/YaRISC/YaRISCRegisterInfo.td b/llvm/lib/Target/YaRISC/YaRISCRegisterInfo.td
new file mode 100644
index 000000000000..afbb3a5339bf
--- /dev/null
+++ b/llvm/lib/Target/YaRISC/YaRISCRegisterInfo.td
@@ -0,0 +1,44 @@
+//===-- YaRISCRegisterInfo.td - YaRISC Register defs -------*- tablegen -*-===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+
+//===----------------------------------------------------------------------===//
+//  Declarations that describe the YaRISC register file
+//===----------------------------------------------------------------------===//
+
+// Registers are identified with 3-bit ID numbers.
+class YaRISCReg<bits<3> enc, string n> : Register<n> {
+  let HWEncoding{2-0} = enc;
+  let Namespace = "YaRISC";
+}
+
+class YaRISCCtrlReg<string n>: Register<n> {
+  let Namespace = "YaRISC";
+}
+
+// General purpose registers
+def R0 : YaRISCReg<0, "r0">, DwarfRegNum<[0]>;
+def R1 : YaRISCReg<1, "r1">, DwarfRegNum<[1]>;
+def R2 : YaRISCReg<2, "r2">, DwarfRegNum<[2]>;
+def R3 : YaRISCReg<3, "r3">, DwarfRegNum<[3]>;
+def R4 : YaRISCReg<4, "r4">, DwarfRegNum<[4]>;
+def R5 : YaRISCReg<5, "r5">, DwarfRegNum<[5]>;
+def SP : YaRISCReg<6, "sp">, DwarfRegNum<[6]>;
+def IP : YaRISCReg<7, "ip">, DwarfRegNum<[7]>;
+
+// Status register (negative/zero/carry/overflow)
+def NZCV : YaRISCCtrlReg<"NZCV">;
+
+// Register class for the general purpose registers.
+def GPR : RegisterClass<"YaRISC", [i16], 16,
+                        (add R0, R1, R2, R3, R4, R5, SP, IP)>;
+
+// Register class for the status register.
+def SR : RegisterClass<"YaRISC", [i16], 16, (add NZCV)> {
+  let CopyCost = -1; // Don't allow copying of status registers.
+  let isAllocatable = 0;
+}
