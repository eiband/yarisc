index 000000000000..50435c74c3c2
--- /dev/null
+++ b/llvm/lib/Target/YaRISC/MCTargetDesc/YaRISCMCCodeEmitter.cpp
@@ -0,0 +1,127 @@
+//===-- YaRISCMCCodeEmitter.cpp - Convert YaRISC code to machine code -----===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// This file implements the YaRISCMCCodeEmitter class.
+//
+//===----------------------------------------------------------------------===//
+
+#include "YaRISCMCTargetDesc.h"
+#include "llvm/ADT/SmallVector.h"
+#include "llvm/ADT/Statistic.h"
+#include "llvm/BinaryFormat/ELF.h"
+#include "llvm/MC/MCAsmInfo.h"
+#include "llvm/MC/MCCodeEmitter.h"
+#include "llvm/MC/MCContext.h"
+#include "llvm/MC/MCExpr.h"
+#include "llvm/MC/MCFixup.h"
+#include "llvm/MC/MCInst.h"
+#include "llvm/MC/MCInstrInfo.h"
+#include "llvm/MC/MCObjectFileInfo.h"
+#include "llvm/MC/MCRegisterInfo.h"
+#include "llvm/MC/MCSubtargetInfo.h"
+#include "llvm/MC/MCSymbol.h"
+#include "llvm/Support/Casting.h"
+#include "llvm/Support/EndianStream.h"
+#include <cassert>
+#include <cstdint>
+
+using namespace llvm;
+
+#define DEBUG_TYPE "yarisc-mccodeemitter"
+
+STATISTIC(MCNumEmitted, "Number of MC instructions emitted");
+
+namespace {
+class YaRISCMCCodeEmitter : public MCCodeEmitter {
+  const MCInstrInfo &MCII;
+  MCContext &Ctx;
+
+public:
+  YaRISCMCCodeEmitter(const MCInstrInfo &mcii, MCContext &ctx)
+      : MCII(mcii), Ctx(ctx) {}
+
+  YaRISCMCCodeEmitter(const YaRISCMCCodeEmitter &) = delete;
+  YaRISCMCCodeEmitter &operator=(const YaRISCMCCodeEmitter &) = delete;
+
+  ~YaRISCMCCodeEmitter() override = default;
+
+  void encodeInstruction(const MCInst &MI, SmallVectorImpl<char> &CB,
+                         SmallVectorImpl<MCFixup> &Fixups,
+                         const MCSubtargetInfo &STI) const override;
+
+  // getBinaryCodeForInstr - TableGen'erated function for getting the
+  // binary encoding for an instruction.
+  uint64_t getBinaryCodeForInstr(const MCInst &MI,
+                                 SmallVectorImpl<MCFixup> &Fixups,
+                                 const MCSubtargetInfo &STI) const;
+
+  /// getMachineOpValue - Return binary encoding of operand. If the machine
+  /// operand requires relocation, record the relocation and return zero.
+  unsigned getMachineOpValue(const MCInst &MI, const MCOperand &MO,
+                             SmallVectorImpl<MCFixup> &Fixups,
+                             const MCSubtargetInfo &STI) const;
+};
+} // namespace
+
+void YaRISCMCCodeEmitter::encodeInstruction(const MCInst &MI,
+                                            SmallVectorImpl<char> &CB,
+                                            SmallVectorImpl<MCFixup> &Fixups,
+                                            const MCSubtargetInfo &STI) const {
+  uint64_t Binary = getBinaryCodeForInstr(MI, Fixups, STI);
+  unsigned Size = MCII.get(MI.getOpcode()).getSize();
+  auto Endianness = Ctx.getAsmInfo()->isLittleEndian()
+                        ? llvm::endianness::little
+                        : llvm::endianness::big;
+
+  switch (Size) {
+  default:
+    llvm_unreachable("Unexpected instruction size");
+  case 2:
+    support::endian::write<uint16_t>(CB, Binary, Endianness);
+    break;
+  case 4:
+    support::endian::write<uint32_t>(CB, Binary, Endianness);
+    break;
+  }
+
+  ++MCNumEmitted;
+}
+
+unsigned
+YaRISCMCCodeEmitter::getMachineOpValue(const MCInst &MI, const MCOperand &MO,
+                                       SmallVectorImpl<MCFixup> &Fixups,
+                                       const MCSubtargetInfo &STI) const {
+  if (MO.isReg())
+    return Ctx.getRegisterInfo()->getEncodingValue(MO.getReg());
+
+  if (MO.isImm())
+    return MO.getImm();
+
+  assert(MO.isExpr());
+  const MCExpr *Expr = MO.getExpr();
+  if (auto *SExpr = dyn_cast<MCSpecifierExpr>(Expr)) {
+    uint16_t Kind = SExpr->getSpecifier();
+    bool PCRel = (Kind == ELF::R_YARISC_PCREL32);
+    Fixups.push_back(MCFixup::create(0, Expr, Kind, PCRel));
+    return 0;
+  }
+
+  int64_t Res;
+  if (Expr->evaluateAsAbsolute(Res))
+    return Res;
+
+  llvm_unreachable("Unhandled expression!");
+  return 0;
+}
+
+#include "YaRISCGenMCCodeEmitter.inc"
+
+MCCodeEmitter *llvm::createYaRISCMCCodeEmitter(const MCInstrInfo &MCII,
+                                               MCContext &Ctx) {
+  return new YaRISCMCCodeEmitter(MCII, Ctx);
+}
