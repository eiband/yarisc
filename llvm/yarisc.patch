+
+class InstYaRISC<int sz, dag outs, dag ins, string asmstr, list<dag> pattern,
+                 InstrItinClass itin = NoItinerary>
+    : Instruction {
+  field bits<32> Inst;
+
+  let Namespace = "YaRISC";
+  let Size = sz;
+
+  bits<6> opcode;
+  let Inst{5-0} = opcode;
+
+  dag OutOperandList = outs;
+  dag InOperandList = ins;
+  let AsmString = asmstr;
+  let Pattern = pattern;
+
+  let Itinerary = itin;
+}
+
+class InstOp<int sz, dag outs, dag ins, string asmstr, list<dag> pattern,
+             InstrItinClass itin = NoItinerary>
+  : InstYaRISC<sz, outs, ins, asmstr, pattern, itin> {
+  bits<3> op0;
+  bits<6> ops;
+  bits<1> sel;
+  let Inst{8-6} = op0;
+  let Inst{14-9} = ops;
+  let Inst{15} = sel;
+}
+
+class InstOpImm<int sz, dag outs, dag ins, string asmstr, list<dag> pattern,
+                InstrItinClass itin = NoItinerary>
+  : InstOp<sz, outs, ins, asmstr, pattern, itin> {
+  bits<4> st;
+  bits<1> as;
+  bits<1> loc;
+  let ops{3-0} = st;
+  let ops{4} = as;
+  let ops{5} = loc;
+  let sel = 1;
+}
+
+class InstOpImm4<dag outs, dag ins, string asmstr, list<dag> pattern,
+                 InstrItinClass itin = NoItinerary>
+  : InstOpImm<2, outs, ins, asmstr, pattern, itin> {
+  bits<4> imm;
+  let st = imm;
+  let loc = 0;
+}
+
+class InstOpImm16<dag outs, dag ins, string asmstr, list<dag> pattern,
+                  InstrItinClass itin = NoItinerary>
+  : InstOpImm<4, outs, ins, asmstr, pattern, itin> {
+  bits<16> imm;
+  let Inst{31-16} = imm;
+  let loc = 1;
+}
+
+class InstOpReg<dag outs, dag ins, string asmstr, list<dag> pattern,
+                InstrItinClass itin = NoItinerary>
+  : InstOp<2, outs, ins, asmstr, pattern, itin> {
+  bits<3> op1;
+  bits<3> op2;
+  let ops{2-0} = op1;
+  let ops{5-3} = op2;
+  let sel = 0;
+}
+
+class InstOp0<bits<6> op, dag outs, dag ins, string asmstr, list<dag> pattern,
+              InstrItinClass itin = NoItinerary>
+  : InstOp<2, outs, ins, asmstr, pattern, itin> {
+  let opcode = op;
+  let op0 = 0;
+  let ops = 0;
+  let sel = 0;
+}
+
+class InstOp1Reg<bits<6> op, dag outs, dag ins, string asmstr,
+                 list<dag> pattern, InstrItinClass itin = NoItinerary>
+  : InstOpReg<outs, ins, asmstr, pattern, itin> {
+  let opcode = op;
+  let op1 = 0;
+  let op2 = 0;
+}
+
+class InstOp2Reg<bits<6> op, dag outs, dag ins, string asmstr,
+                 list<dag> pattern, InstrItinClass itin = NoItinerary>
+  : InstOpReg<outs, ins, asmstr, pattern, itin> {
+  let opcode = op;
+  let op2 = 0;
+}
+
+class InstOp2RegImm4<bits<6> op, dag outs, dag ins, string asmstr,
+                     list<dag> pattern, InstrItinClass itin = NoItinerary>
+  : InstOpImm4<outs, ins, asmstr, pattern, itin> {
+  let opcode = op;
+  let as = 1;
+}
+
+class InstOp2RegImm16<bits<6> op, dag outs, dag ins, string asmstr,
+                      list<dag> pattern, InstrItinClass itin = NoItinerary>
+  : InstOpImm16<outs, ins, asmstr, pattern, itin> {
+  let opcode = op;
+  let st = 0;
+  let as = 1;
+}
+
+class InstOp3Reg<bits<6> op, dag outs, dag ins, string asmstr,
+                 list<dag> pattern, InstrItinClass itin = NoItinerary>
+  : InstOpReg<outs, ins, asmstr, pattern, itin> {
+  let opcode = op;
+}
+
+class InstOp3RegImm4<bits<6> op, dag outs, dag ins, string asmstr,
+                     list<dag> pattern, InstrItinClass itin = NoItinerary>
+  : InstOpImm4<outs, ins, asmstr, pattern, itin> {
+  let opcode = op;
+  let as = 1;
+}
+
+class InstOp3RegImm16<bits<6> op, dag outs, dag ins, string asmstr,
+                      list<dag> pattern, InstrItinClass itin = NoItinerary>
+  : InstOpImm16<outs, ins, asmstr, pattern, itin> {
+  bits<3> op1;
+  let opcode = op;
+  let st{3} = 0;
+  let st{2-0} = op1;
+  let as = 1;
+}
+
+class InstOp3Imm4Reg<bits<6> op, dag outs, dag ins, string asmstr,
+                     list<dag> pattern, InstrItinClass itin = NoItinerary>
+  : InstOpImm4<outs, ins, asmstr, pattern, itin> {
+  let opcode = op;
+  let as = 0;
+}
+
+class InstOp3Imm16Reg<bits<6> op, dag outs, dag ins, string asmstr,
+                      list<dag> pattern, InstrItinClass itin = NoItinerary>
+  : InstOpImm16<outs, ins, asmstr, pattern, itin> {
+  bits<3> op2;
+  let opcode = op;
+  let st{3} = 0;
+  let st{2-0} = op2;
+  let as = 0;
+}
