+namespace YaRISCII {
+enum {
+  MO_None,
+  MO_CALL,
+  MO_CALL_PLT,
+
+  // Used to differentiate between target-specific "direct" flags and "bitmask"
+  // flags. A machine operand can only have one "direct" flag, but can have
+  // multiple "bitmask" flags.
+  MO_DIRECT_FLAG_MASK = 0x03,
+};
+} // namespace YaRISCII
+
+class YaRISCSubtarget;
+
+class YaRISCInstrInfo : public YaRISCGenInstrInfo {
+  const YaRISCRegisterInfo RI;
+  const YaRISCSubtarget &Subtarget;
+  virtual void anchor();
+
+public:
+  explicit YaRISCInstrInfo(const YaRISCSubtarget &ST);
+
+  const YaRISCRegisterInfo &getRegisterInfo() const { return RI; }
+
+  unsigned getInstSizeInBytes(const MachineInstr &MI) const override;
+
+  void copyPhysReg(MachineBasicBlock &MBB, MachineBasicBlock::iterator MBBI,
+                   const DebugLoc &DL, Register DestReg, Register SrcReg,
+                   bool KillSrc, bool RenamableDest = false,
+                   bool RenamableSrc = false) const override;
+
+  void storeRegToStackSlot(
+      MachineBasicBlock &MBB, MachineBasicBlock::iterator MBBI, Register SrcReg,
+      bool KillSrc, int FrameIndex, const TargetRegisterClass *RC,
+      Register VReg,
+      MachineInstr::MIFlag Flags = MachineInstr::NoFlags) const override;
+
+  void loadRegFromStackSlot(
+      MachineBasicBlock &MBB, MachineBasicBlock::iterator MBBI,
+      Register DestReg, int FrameIndex, const TargetRegisterClass *RC,
+      Register VReg,
+      MachineInstr::MIFlag Flags = MachineInstr::NoFlags) const override;
+
+  bool expandPostRAPseudo(MachineInstr &MI) const override;
+
+  bool
+  reverseBranchCondition(SmallVectorImpl<MachineOperand> &Cond) const override;
+
+  std::pair<unsigned, unsigned>
+  decomposeMachineOperandsTargetFlags(unsigned TF) const override;
+
+  ArrayRef<std::pair<unsigned, const char *>>
+  getSerializableDirectMachineOperandTargetFlags() const override;
+};
+
+} // namespace llvm
+
+#endif // LLVM_LIB_TARGET_YARISC_YARISCINSTRINFO_H
diff --git a/llvm/lib/Target/YaRISC/YaRISCInstrInfo.td b/llvm/lib/Target/YaRISC/YaRISCInstrInfo.td
new file mode 100644
index 000000000000..090788fa8d5c
--- /dev/null
+++ b/llvm/lib/Target/YaRISC/YaRISCInstrInfo.td
@@ -0,0 +1,270 @@
+//===-- YaRISCInstrInfo.td - Target Description for YaRISC Target ---------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// This file describes the YaRISC instructions in TableGen format.
+//
+//===----------------------------------------------------------------------===//
+
+//===----------------------------------------------------------------------===//
+// YaRISC specific DAG Nodes
+//===----------------------------------------------------------------------===//
+
+def callseq_start : SDNode<"ISD::CALLSEQ_START",
+                           SDCallSeqStart<[SDTCisVT<0, i16>, SDTCisVT<1, i16>]>,
+                           [SDNPHasChain, SDNPOutGlue]>;
+def callseq_end : SDNode<"ISD::CALLSEQ_END",
+                         SDCallSeqEnd<[SDTCisVT<0, i16>, SDTCisVT<1, i16>]>,
+                         [SDNPHasChain, SDNPOptInGlue, SDNPOutGlue]>;
+def call : SDNode<"YaRISCISD::CALL",
+                  SDTypeProfile<0, -1, [SDTCisVT<0, iPTR>]>,
+                  [SDNPHasChain, SDNPOutGlue, SDNPOptInGlue, SDNPVariadic]>;
+def ret : SDNode<"YaRISCISD::RET_GLUE", SDTNone,
+                 [SDNPHasChain, SDNPOptInGlue, SDNPVariadic]>;
+
+//===----------------------------------------------------------------------===//
+// Instruction Formats
+//===----------------------------------------------------------------------===//
+
+include "YaRISCInstrFormats.td"
+
+//===----------------------------------------------------------------------===//
+// Feature Predicates
+//===----------------------------------------------------------------------===//
+
+// HasV1 - This predicate is true when the target processor supports V1
+// instructions. TODO: YaRISC
+def HasV1 : Predicate<"Subtarget->isV1()">,
+            AssemblerPredicate<(all_of FeatureV1)>;
+
+//===----------------------------------------------------------------------===//
+// Instruction Pattern Stuff
+//===----------------------------------------------------------------------===//
+
+def simm4 : ImmLeaf<i16, [{ return isInt<4>(Imm); }]>;
+
+def calltarget : Operand<iPTR>;
+
+def yarisc_ptr_rc : RegisterClass<"YaRISC", [i16], 16, (add GPR)>;
+
+def ptr_op : RegisterOperand<yarisc_ptr_rc> {
+  let DecoderMethod = "DecodeGPRRegisterClass";
+}
+
+//===----------------------------------------------------------------------===//
+// Flag Conditions
+//===----------------------------------------------------------------------===//
+
+class CC_YaRISC<bits<4> Val, string Name> {
+  bits<4> Value = Val;
+  string Mnemonic = Name;
+}
+
+def CC_EQ : CC_YaRISC<0b0001, "EQ">;
+def CC_LT : CC_YaRISC<0b0010, "LT">;
+def CC_LE : CC_YaRISC<0b0011, "LE">;
+def CC_LO : CC_YaRISC<0b0100, "LO">;
+def CC_LS : CC_YaRISC<0b0101, "LS">;
+def CC_NE : CC_YaRISC<0b1001, "NE">;
+def CC_GE : CC_YaRISC<0b1010, "GE">;
+def CC_GT : CC_YaRISC<0b1011, "GT">;
+def CC_HS : CC_YaRISC<0b1100, "HS">;
+def CC_HI : CC_YaRISC<0b1101, "HI">;
+
+//===----------------------------------------------------------------------===//
+// Instruction Class Templates
+//===----------------------------------------------------------------------===//
+
+multiclass Move<bits<6> op, string opstr> {
+  def r : InstOp2Reg<op, (outs GPR:$op0), (ins GPR:$op1),
+                     !strconcat(opstr, " $op0, $op1"), []>;
+
+  def i16 : InstOp2RegImm16<op, (outs GPR:$op0), (ins i16imm:$imm),
+                            !strconcat(opstr, " $op0, $imm"),
+                            [(set GPR:$op0, imm:$imm)]>;
+
+  def i4 : InstOp2RegImm4<op, (outs GPR:$op0), (ins i16imm:$imm),
+                          !strconcat(opstr, " $op0, $imm"),
+                          [(set GPR:$op0, simm4:$imm)]>;
+}
+
+multiclass Load<bits<6> op, string opstr> {
+  def r : InstOp2Reg<op, (outs GPR:$op0), (ins GPR:$op1),
+                     !strconcat(opstr, " $op0, [$op1]"),
+                     [(set GPR:$op0, (load GPR:$op1))]>;
+
+  def i16 : InstOp2RegImm16<op, (outs GPR:$op0), (ins i16imm:$imm),
+                            !strconcat(opstr, " $op0, [$imm]"),
+                            [(set GPR:$op0, (load imm:$imm))]>;
+
+  def i4 : InstOp2RegImm4<op, (outs GPR:$op0), (ins i16imm:$imm),
+                          !strconcat(opstr, " $op0, [$imm]"),
+                          [(set GPR:$op0, (load simm4:$imm))]>;
+}
+
+multiclass IndexedLoad<bits<6> op, string opstr> {
+  def rr : InstOp3Reg<op, (outs GPR:$op0), (ins GPR:$op1, GPR:$op2),
+                      !strconcat(opstr, " $op0, [$op1, $op2]"),
+                      [(set GPR:$op0, (load (add GPR:$op1, GPR:$op2)))]>;
+
+  def ri16 : InstOp3RegImm16<op, (outs GPR:$op0), (ins GPR:$op1, i16imm:$imm),
+                             !strconcat(opstr, " $op0, [$op1, $imm]"),
+                             [(set GPR:$op0, (load (add GPR:$op1, imm:$imm)))]>;
+
+  let Uses = [SP] in
+  def spi4 : InstOp3RegImm4<op, (outs GPR:$op0), (ins i16imm:$imm),
+                            !strconcat(opstr, " $op0, [sp, $imm]"),
+                            [(set GPR:$op0, (load (add SP, simm4:$imm)))]>;
+
+  let Uses = [R5] in
+  def fpi4 : InstOp3Imm4Reg<op, (outs GPR:$op0), (ins i16imm:$imm),
+                            !strconcat(opstr, " $op0, [r5, $imm]"),
+                            [(set GPR:$op0, (load (add R5, simm4:$imm)))]>;
+}
+
+multiclass Store<bits<6> op, string opstr> {
+  def r : InstOp2Reg<op, (outs), (ins GPR:$op0, GPR:$op1),
+                     !strconcat(opstr, " $op0, [$op1]"),
+                     [(store GPR:$op0, GPR:$op1)]>;
+
+  def i16 : InstOp2RegImm16<op, (outs), (ins GPR:$op0, i16imm:$imm),
+                            !strconcat(opstr, " $op0, [$imm]"),
+                            [(store GPR:$op0, imm:$imm)]>;
+
+  def i4 : InstOp2RegImm4<op, (outs), (ins GPR:$op0, i16imm:$imm),
+                          !strconcat(opstr, " $op0, [$imm]"),
+                          [(store GPR:$op0, simm4:$imm)]>;
+}
+
+multiclass IndexedStore<bits<6> op, string opstr> {
+  def rr : InstOp3Reg<op, (outs GPR:$op0), (ins GPR:$op1, GPR:$op2),
+                      !strconcat(opstr, " $op0, [$op1, $op2]"),
+                      [(store GPR:$op0, (add GPR:$op1, GPR:$op2))]>;
+
+  def ri16 : InstOp3RegImm16<op, (outs), (ins GPR:$op0, GPR:$op1, i16imm:$imm),
+                             !strconcat(opstr, " $op0, [$op1, $imm]"),
+                             [(store GPR:$op0, (add GPR:$op1, imm:$imm))]>;
+
+  let Uses = [SP] in
+  def spi4 : InstOp3RegImm4<op, (outs), (ins GPR:$op0, i16imm:$imm),
+                            !strconcat(opstr, " $op0, [sp, $imm]"),
+                            [(store GPR:$op0, (add SP, simm4:$imm))]>;
+
+  let Uses = [R5] in
+  def fpi4 : InstOp3Imm4Reg<op, (outs), (ins GPR:$op0, i16imm:$imm),
+                            !strconcat(opstr, " $op0, [r5, $imm]"),
+                            [(store GPR:$op0, (add R5, simm4:$imm))]>;
+}
+
+multiclass UnaryArith<bits<6> op, string opstr, SDNode opnode> {
+  def r : InstOp2Reg<op, (outs GPR:$op0), (ins GPR:$op1),
+                     !strconcat(opstr, " $op0, $op1"),
+                     [(set GPR:$op0, (opnode GPR:$op1))]>;
+
+  def i16 : InstOp2RegImm16<op, (outs GPR:$op0), (ins i16imm:$imm),
+                            !strconcat(opstr, " $op0, $imm"),
+                            [(set GPR:$op0, (opnode imm:$imm))]>;
+
+  def i4 : InstOp2RegImm4<op, (outs GPR:$op0), (ins i16imm:$imm),
+                          !strconcat(opstr, " $op0, $imm"),
+                          [(set GPR:$op0, (opnode simm4:$imm))]>;
+}
+
+multiclass BinaryArith<bits<6> op, string opstr, SDNode opnode> {
+  def rr : InstOp3Reg<op, (outs GPR:$op0), (ins GPR:$op1, GPR:$op2),
+                      !strconcat(opstr, " $op0, $op1, $op2"),
+                      [(set GPR:$op0, (opnode GPR:$op1, GPR:$op2))]>;
+
+  def ri16 : InstOp3RegImm16<op, (outs GPR:$op0), (ins GPR:$op1, i16imm:$imm),
+                             !strconcat(opstr, " $op0, $op1, $imm"),
+                             [(set GPR:$op0, (opnode GPR:$op1, imm:$imm))]>;
+
+  let Constraints = "$op0 = $op1" in
+  def ri4 : InstOp3RegImm4<op, (outs GPR:$op0), (ins GPR:$op1, i16imm:$imm),
+                           !strconcat(opstr, " $op0, $op1, $imm"),
+                           [(set GPR:$op0, (opnode GPR:$op1, simm4:$imm))]>;
+}
+
+multiclass AsymmetricArith<bits<6> op, string opstr, SDNode opnode>
+  : BinaryArith<op, opstr, opnode> {
+  def i16r : InstOp3Imm16Reg<op, (outs GPR:$op0), (ins i16imm:$imm, GPR:$op2),
+                             !strconcat(opstr, " $op0, $imm, $op2"), []>;
+
+  let Constraints = "$op0 = $op2" in
+  def i4r : InstOp3Imm4Reg<op, (outs GPR:$op0), (ins i16imm:$imm, GPR:$op2),
+                           !strconcat(opstr, " $op0, $imm, $op2"), []>;
+}
+
+//===----------------------------------------------------------------------===//
+// Instructions
+//===----------------------------------------------------------------------===//
+
+defm MOV : Move<0b000001, "MOV">;
+defm LDR : Load<0b000010, "LDR">;
+defm LDX : IndexedLoad<0b000011, "LDX">;
+defm STR : Store<0b000100, "STR">;
+defm STX : IndexedStore<0b000101, "STX">;
+defm ADD : BinaryArith<0b010000, "ADD", add>;
+defm SUB : AsymmetricArith<0b010100, "SUB", sub>;
+// TODO: YaRISC not yet assigned
+defm XOR : BinaryArith<0b111100, "XOR", xor>;
+
+// TODO: YaRISC need to model flags
+// let Defs = [NZCV] in {
+//   defm ADDS : BinaryArith<0b010001, "ADDS", add>;
+//   defm SUBS : AsymmetricArith<0b010101, "SUBS", sub>;
+// }
+
+def NOP : InstOp0<0b111111, (outs), (ins), "NOP", []>;
+
+def SUBreg : PatFrag<(ops node:$rs, node:$imm),
+                     (add (sub 0, node:$rs), node:$imm)>;
+
+def : Pat<(SUBreg GPR:$rs, imm:$imm),
+          (SUBi16r i16imm:$imm, GPR:$rs)>;
+def : Pat<(SUBreg GPR:$rs, simm4:$imm),
+          (SUBi4r i16imm:$imm, GPR:$rs)>;
+
+def to_tframeindex : SDNodeXForm<frameindex, [{
+  return CurDAG->getTargetFrameIndex(N->getIndex(), N->getValueType(0));
+}]>;
+
+def : Pat<(frameindex:$fi),
+          (ADDri16 (iPTR (to_tframeindex $fi)), 0)>;
+def : Pat<(add frameindex:$fi, imm:$offset),
+          (ADDri16 (iPTR (to_tframeindex $fi)), i16imm:$offset)>;
+
+//===----------------------------------------------------------------------===//
+// Pseudo-instructions
+//===----------------------------------------------------------------------===//
+
+class Pseudo<dag outs, dag ins, string asmstr, list<dag> pattern>
+   : InstYaRISC<0, outs, ins, asmstr, pattern> {
+  let isCodeGenOnly = 1;
+  let isPseudo = 1;
+}
+
+let Defs = [SP], Uses = [SP] in {
+  def ADJCALLSTACKDOWN : Pseudo<(outs), (ins i16imm:$amt, i16imm:$align),
+                                "#ADJCALLSTACKDOWN $amt $align",
+                                [(callseq_start timm:$amt, timm:$align)] >;
+  def ADJCALLSTACKUP : Pseudo<(outs), (ins i16imm:$amt, i16imm:$align),
+                              "#ADJCALLSTACKUP $amt $align",
+                              [(callseq_end timm:$amt, timm:$align)] >;
+}
+
+let Uses = [SP] in {
+  // Register R2 is used to calculate the return address.
+  let Defs = [SP, IP, R2], isCall = 1 in
+  def CALL : Pseudo<(outs), (ins calltarget:$target), "#CALL $target", []>;
+  let Defs = [SP, IP], isTerminator = 1, isReturn = 1, isBarrier = 1 in
+  def RET : Pseudo<(outs), (ins), "#RET", []>;
+}
+
+def : Pat<(call tglobaladdr:$target), (CALL tglobaladdr:$target)>;
+def : Pat<(call texternalsym:$target), (CALL texternalsym:$target)>;
+def : Pat<(ret), (RET)>;
