+
+#define GET_REGINFO_MC_DESC
+#include "YaRISCGenRegisterInfo.inc"
+
+static MCAsmInfo *createYaRISCMCAsmInfo(const MCRegisterInfo &MRI,
+                                        const Triple &TT,
+                                        const MCTargetOptions &Options) {
+  MCAsmInfo *MAI = new YaRISCELFMCAsmInfo(TT);
+  // Initial state of the frame pointer is SP.
+  unsigned Reg = MRI.getDwarfRegNum(YaRISC::SP, true);
+  MAI->addInitialFrameState(MCCFIInstruction::cfiDefCfa(nullptr, Reg, 0));
+  return MAI;
+}
+
+static MCInstrInfo *createYaRISCMCInstrInfo() {
+  MCInstrInfo *X = new MCInstrInfo();
+  InitYaRISCMCInstrInfo(X);
+  return X;
+}
+
+static MCRegisterInfo *createYaRISCMCRegisterInfo(const Triple &TT) {
+  MCRegisterInfo *X = new MCRegisterInfo();
+  InitYaRISCMCRegisterInfo(X, YaRISC::NoRegister, 0, 0, YaRISC::IP);
+  return X;
+}
+
+static MCSubtargetInfo *
+createYaRISCMCSubtargetInfo(const Triple &TT, StringRef CPU, StringRef FS) {
+  if (CPU.empty())
+    CPU = "minimal";
+
+  MCSubtargetInfo *STI =
+      createYaRISCMCSubtargetInfoImpl(TT, CPU, /*TuneCPU=*/CPU, FS);
+
+  return STI;
+}
+
+static MCTargetStreamer *
+createObjectTargetStreamer(MCStreamer &S, const MCSubtargetInfo &STI) {
+  return new YaRISCTargetELFStreamer(S, STI);
+}
+
+static MCTargetStreamer *createTargetAsmStreamer(MCStreamer &S,
+                                                 formatted_raw_ostream &OS,
+                                                 MCInstPrinter *InstPrint) {
+  return new YaRISCTargetAsmStreamer(S, OS);
+}
+
+static MCTargetStreamer *createNullTargetStreamer(MCStreamer &S) {
+  return new YaRISCTargetStreamer(S);
+}
+
+static MCInstPrinter *createYaRISCMCInstPrinter(const Triple &T,
+                                                unsigned SyntaxVariant,
+                                                const MCAsmInfo &MAI,
+                                                const MCInstrInfo &MII,
+                                                const MCRegisterInfo &MRI) {
+  return new YaRISCInstPrinter(MAI, MII, MRI);
+}
+
+extern "C" LLVM_ABI LLVM_EXTERNAL_VISIBILITY void
+LLVMInitializeYaRISCTargetMC() {
+  Target &T = getTheYaRISCTarget();
+
+  // Register the MC asm info.
+  RegisterMCAsmInfoFn X(T, createYaRISCMCAsmInfo);
+
+  // Register the MC instruction info.
+  TargetRegistry::RegisterMCInstrInfo(T, createYaRISCMCInstrInfo);
+
+  // Register the MC register info.
+  TargetRegistry::RegisterMCRegInfo(T, createYaRISCMCRegisterInfo);
+
+  // Register the MC subtarget info.
+  TargetRegistry::RegisterMCSubtargetInfo(T, createYaRISCMCSubtargetInfo);
+
+  // Register the MC Code Emitter.
+  TargetRegistry::RegisterMCCodeEmitter(T, createYaRISCMCCodeEmitter);
+
+  // Register the asm backend.
+  TargetRegistry::RegisterMCAsmBackend(T, createYaRISCAsmBackend);
+
+  // Register the object target streamer.
+  TargetRegistry::RegisterObjectTargetStreamer(T, createObjectTargetStreamer);
+
+  // Register the asm streamer.
+  TargetRegistry::RegisterAsmTargetStreamer(T, createTargetAsmStreamer);
+
+  // Register the null streamer.
+  TargetRegistry::RegisterNullTargetStreamer(T, createNullTargetStreamer);
+
+  // Register the MCInstPrinter
+  TargetRegistry::RegisterMCInstPrinter(T, createYaRISCMCInstPrinter);
+}
